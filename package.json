{
  "name": "planet-forge",
  "version": "1.0.0",
  "description": "Procedural 3D planet generator: tectonic-plate spherical height field with oceans, clouds, atmosphere, rings and starfield. Deterministic seeds, live parameters, GLB/JSON/PNG export.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "three",
    "threejs",
    "procedural",
    "planet",
    "terrain",
    "icosphere",
    "tectonic",
    "shader",
    "webgl",
    "generator"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:e2e": "node e2e/run-e2e.mjs",
    "bench": "node scripts/bench.mjs",
    "shots": "node e2e/capture-shots.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "8.3.4"
  }
}
